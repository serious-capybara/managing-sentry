-- Managing Sentry: full rebuild with the fixed Data Dictionary + all existing data.
-- Drops and recreates the 7 tables and the user_role type, then re-inserts your data.
-- Run the whole thing at once in the Supabase SQL editor. One transaction: all or nothing.
BEGIN;

DROP TABLE IF EXISTS public.histories, public.order_items, public.stock_adjustments,
                     public.orders, public.products, public.users, public.capital_configs CASCADE;
DROP TYPE IF EXISTS public.user_role;

CREATE TYPE public.user_role AS ENUM ('Admin', 'Manager', 'Staff');

CREATE TABLE public.users (
  user_id       INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  full_name     VARCHAR(100) NOT NULL,
  username      VARCHAR(50)  NOT NULL UNIQUE,
  password_hash VARCHAR(255) NOT NULL,
  role          public.user_role NOT NULL
);

CREATE TABLE public.capital_configs (
  config_id        INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  starting_capital NUMERIC(12,2) NOT NULL,
  current_balance  NUMERIC(12,2) NOT NULL,
  last_updated_at  TIMESTAMP NOT NULL DEFAULT (now() AT TIME ZONE 'Asia/Manila')
);

CREATE TABLE public.products (
  product_id            INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  name                  VARCHAR(100)  NOT NULL,
  category              VARCHAR(50)   NOT NULL,
  base_cost             NUMERIC(10,2) NOT NULL,
  markup_amount         NUMERIC(10,2) NOT NULL,
  retail_price          NUMERIC(10,2) NOT NULL,
  stock_quantity        INTEGER NOT NULL DEFAULT 0,
  expiration_date       DATE,
  low_stock_alert_level INTEGER NOT NULL DEFAULT 20
);

CREATE TABLE public.orders (
  order_id              INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  user_id               INTEGER NOT NULL REFERENCES public.users(user_id) ON DELETE RESTRICT,
  transaction_timestamp TIMESTAMP NOT NULL DEFAULT (now() AT TIME ZONE 'Asia/Manila'),
  total_amount          NUMERIC(10,2) NOT NULL CHECK (total_amount >= 0),
  amount_tendered       NUMERIC(10,2) NOT NULL,
  change_given          NUMERIC(10,2) NOT NULL,
  notes                 TEXT
);

CREATE TABLE public.order_items (
  order_item_id  INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  order_id       INTEGER NOT NULL REFERENCES public.orders(order_id) ON DELETE CASCADE,
  product_id     INTEGER NOT NULL REFERENCES public.products(product_id),
  quantity       INTEGER NOT NULL CHECK (quantity > 0),
  cost_snapshot  NUMERIC(10,2) NOT NULL,
  price_snapshot NUMERIC(10,2) NOT NULL,
  line_subtotal  NUMERIC(10,2) NOT NULL,
  CONSTRAINT order_items_order_product_unique UNIQUE (order_id, product_id)
);

CREATE TABLE public.stock_adjustments (
  adjustment_id    INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  product_id       INTEGER NOT NULL REFERENCES public.products(product_id),
  user_id          INTEGER NOT NULL REFERENCES public.users(user_id) ON DELETE RESTRICT,
  adjustment_type  VARCHAR(30) NOT NULL,
  quantity_changed INTEGER NOT NULL,
  unit_cost        NUMERIC(10,2),
  transaction_date TIMESTAMP NOT NULL DEFAULT (now() AT TIME ZONE 'Asia/Manila'),
  audit_notes      VARCHAR(255)
);

CREATE TABLE public.histories (
  history_id       INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  order_id         INTEGER NOT NULL REFERENCES public.orders(order_id) ON DELETE CASCADE,
  status_timestamp TIMESTAMP NOT NULL DEFAULT (now() AT TIME ZONE 'Asia/Manila'),
  order_status     VARCHAR(20) NOT NULL DEFAULT 'COMPLETED'
);

