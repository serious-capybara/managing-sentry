DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_NAME=your_db_name_here
DB_PASSWORD=your_password_here

# Signs the session cookie. Use a long random string; keep it identical across workers.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me
# Set to true when served over HTTPS
SESSION_HTTPS_ONLY=false
# REQUIRED when the frontend runs on a different port/origin than this API (cookies need CORS + credentials).
# Comma-separated exact origins. Use 127.0.0.1 consistently (not localhost).
CORS_ORIGINS=http://127.0.0.1:5500

# Zone of timestamps stored without a timezone (default Asia/Manila)
DB_TIMEZONE=Asia/Manila

# Login for the API documentation pages (/docs, /redoc, /openapi.json).
# If DOCS_PASSWORD is empty, the docs are turned off completely.
DOCS_USERNAME=admin
DOCS_PASSWORD=
