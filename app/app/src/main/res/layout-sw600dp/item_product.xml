<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/row_container"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:orientation="horizontal"
    android:background="@android:color/transparent"
    android:visibility="gone"
    android:layout_marginBottom="1dp">

    <TextView
        android:id="@+id/row_name"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2.5"
        android:layout_marginEnd="2dp"
        android:background="@drawable/cell_white_bg"
        android:paddingHorizontal="24dp"
        android:text=""
        android:textSize="@dimen/body_two"
        android:textColor="@color/slate_900"
        android:gravity="start|center_vertical"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/row_category"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:layout_marginEnd="2dp"
        android:background="@drawable/cell_white_bg"
        android:text=""
        android:textSize="@dimen/body_two"
        android:textColor="@color/slate_600"
        android:gravity="center" />

    <TextView
        android:id="@+id/row_srp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:layout_marginEnd="2dp"
        android:background="@drawable/cell_white_bg"
        android:text=""
        android:textSize="@dimen/body_two"
        android:textColor="@color/slate_600"
        android:gravity="center" />

    <TextView
        android:id="@+id/row_timestamp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.5"
        android:layout_marginEnd="2dp"
        android:background="@drawable/cell_white_bg"
        android:text=""
        android:textSize="@dimen/body_two"
        android:textColor="@color/slate_600"
        android:gravity="center" />

    <TextView
        android:id="@+id/row_order"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:layout_marginEnd="2dp"
        android:background="@drawable/cell_white_bg"
        android:text=""
        android:textSize="@dimen/body_two"
        android:textColor="@color/slate_600"
        android:gravity="center" />

    <TextView
        android:id="@+id/row_quantity"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:layout_marginEnd="2dp"
        android:background="@drawable/cell_white_bg"
        android:text=""
        android:textSize="@dimen/body_two"
        android:textColor="@color/slate_600"
        android:gravity="center" />

    <TextView
        android:id="@+id/row_sales"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:layout_marginEnd="2dp"
        android:background="@drawable/cell_white_bg"
        android:text=""
        android:textSize="@dimen/body_two"
        android:textColor="@color/slate_900"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/row_subtotal"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:layout_marginEnd="2dp"
        android:background="@drawable/cell_white_bg"
        android:text=""
        android:textSize="@dimen/body_two"
        android:textColor="@color/slate_900"
        android:textStyle="bold"
        android:gravity="center" />

    <FrameLayout
        android:id="@+id/row_action_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.5"
        android:layout_marginEnd="2dp"
        android:background="@drawable/cell_white_bg">

        <Button
            android:id="@+id/row_checkout"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_button_green"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:padding="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/btn_add_to_cart"
            android:textAllCaps="false"
            android:textSize="@dimen/body_three"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:includeFontPadding="false" />

        <LinearLayout
            android:id="@+id/row_cart_actions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btn_minus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_minus"
                android:scaleType="centerInside"
                app:tint="@color/sidebar_btn_critical" />

            <ImageButton
                android:id="@+id/btn_plus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_plus"
                android:scaleType="centerInside"
                app:tint="@color/success_green" />

        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/row_status_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.5"
        android:background="@drawable/cell_white_bg">

        <TextView
            android:id="@+id/row_status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="12dp"
            android:text=""
            android:textSize="@dimen/body_two"
            android:textColor="@color/slate_600"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end" />

        <View
            android:id="@+id/row_notes_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/shape_status_dot_red"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
