<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cart_container_bg"
    android:padding="8dp">

    <TextView
        android:id="@+id/cart_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:text="@string/label_cart"
        android:textSize="@dimen/body_one"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <include
        android:id="@+id/cart_header"
        layout="@layout/layout_pos_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/cart_title" />

    <TextView
        android:id="@+id/tv_empty_cart"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/empty_cart"
        android:textColor="@color/slate_600"
        android:textSize="14sp"
        android:textStyle="normal"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/cart_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/cart_scrollview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/cart_header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/cart_items_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <include android:id="@+id/cart_row_1" layout="@layout/item_product" />
            <include android:id="@+id/cart_row_2" layout="@layout/item_product" />
            <include android:id="@+id/cart_row_3" layout="@layout/item_product" />
            <include android:id="@+id/cart_row_4" layout="@layout/item_product" />
            <include android:id="@+id/cart_row_5" layout="@layout/item_product" />
            <include android:id="@+id/cart_row_6" layout="@layout/item_product" />
            <include android:id="@+id/cart_row_7" layout="@layout/item_product" />
            <include android:id="@+id/cart_row_8" layout="@layout/item_product" />
            <include android:id="@+id/cart_row_9" layout="@layout/item_product" />
            <include android:id="@+id/cart_row_10" layout="@layout/item_product" />
            <include android:id="@+id/cart_row_11" layout="@layout/item_product" />
            <include android:id="@+id/cart_row_12" layout="@layout/item_product" />
            <include android:id="@+id/cart_row_13" layout="@layout/item_product" />
            <include android:id="@+id/cart_row_14" layout="@layout/item_product" />
            <include android:id="@+id/cart_row_15" layout="@layout/item_product" />
            <include android:id="@+id/cart_row_16" layout="@layout/item_product" />
            <include android:id="@+id/cart_row_17" layout="@layout/item_product" />
            <include android:id="@+id/cart_row_18" layout="@layout/item_product" />
            <include android:id="@+id/cart_row_19" layout="@layout/item_product" />
            <include android:id="@+id/cart_row_20" layout="@layout/item_product" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>