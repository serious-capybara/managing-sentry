<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/row_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/row_min_height"
    android:orientation="horizontal"
    android:background="@android:color/transparent">

    <TextView
        android:id="@+id/row_name"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2.0"
        android:layout_marginTop="@dimen/grid_spacing"
        android:layout_marginEnd="@dimen/grid_spacing"
        android:background="@drawable/cell_white_bg"
        android:paddingHorizontal="12dp"
        android:paddingVertical="@dimen/cell_padding"
        android:text="Name"
        android:textSize="@dimen/body_three"
        android:textColor="@color/text_primary"
        android:gravity="start|center_vertical" />

    <TextView
        android:id="@+id/row_category"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:layout_marginTop="@dimen/grid_spacing"
        android:layout_marginEnd="@dimen/grid_spacing"
        android:background="@drawable/cell_white_bg"
        android:padding="@dimen/cell_padding"
        android:text="Category"
        android:textSize="@dimen/body_three"
        android:textColor="@color/text_secondary"
        android:gravity="center" />

    <TextView
        android:id="@+id/row_srp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:layout_marginTop="@dimen/grid_spacing"
        android:layout_marginEnd="@dimen/grid_spacing"
        android:background="@drawable/cell_white_bg"
        android:padding="@dimen/cell_padding"
        android:text="₱ 0.00"
        android:textSize="@dimen/body_three"
        android:textColor="@color/text_secondary"
        android:gravity="center" />

    <TextView
        android:id="@+id/row_timestamp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.5"
        android:layout_marginTop="@dimen/grid_spacing"
        android:layout_marginEnd="@dimen/grid_spacing"
        android:background="@drawable/cell_white_bg"
        android:padding="@dimen/cell_padding"
        android:text="Time"
        android:textSize="@dimen/body_three"
        android:textColor="@color/text_secondary"
        android:gravity="center" />

    <TextView
        android:id="@+id/row_order"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:layout_marginTop="@dimen/grid_spacing"
        android:layout_marginEnd="@dimen/grid_spacing"
        android:background="@drawable/cell_white_bg"
        android:padding="@dimen/cell_padding"
        android:text="ORD-0"
        android:textSize="@dimen/body_three"
        android:textColor="@color/text_secondary"
        android:gravity="center" />

    <TextView
        android:id="@+id/row_quantity"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:layout_marginTop="@dimen/grid_spacing"
        android:layout_marginEnd="@dimen/grid_spacing"
        android:background="@drawable/cell_white_bg"
        android:padding="@dimen/cell_padding"
        android:text="0"
        android:textSize="@dimen/body_three"
        android:textColor="@color/text_secondary"
        android:gravity="center" />

    <TextView
        android:id="@+id/row_sales"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:layout_marginTop="@dimen/grid_spacing"
        android:layout_marginEnd="@dimen/grid_spacing"
        android:background="@drawable/cell_white_bg"
        android:padding="@dimen/cell_padding"
        android:text="₱ 0.00"
        android:textSize="@dimen/body_three"
        android:textColor="@color/text_secondary"
        android:gravity="center" />

    <TextView
        android:id="@+id/row_subtotal"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:layout_marginTop="@dimen/grid_spacing"
        android:layout_marginEnd="@dimen/grid_spacing"
        android:background="@drawable/cell_white_bg"
        android:padding="@dimen/cell_padding"
        android:text="₱ 0.00"
        android:textSize="@dimen/body_three"
        android:textColor="@color/text_secondary"
        android:gravity="center" />

    <FrameLayout
        android:id="@+id/row_action_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.5"
        android:layout_marginTop="@dimen/grid_spacing"
        android:layout_marginEnd="@dimen/grid_spacing">

        <Button
            android:id="@+id/row_checkout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/button_green_bg"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/btn_add_to_cart"
            android:textAllCaps="false"
            android:textSize="@dimen/body_three"
            android:textColor="@android:color/white"
            android:gravity="center" />

        <LinearLayout
            android:id="@+id/row_cart_actions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/cell_white_bg"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btn_minus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_minus"
                android:scaleType="centerInside"
                app:tint="@color/sidebar_btn_critical" />

            <ImageButton
                android:id="@+id/btn_plus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_plus"
                android:scaleType="centerInside"
                app:tint="@color/success_green" />

        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/row_status"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:layout_marginTop="@dimen/grid_spacing"
        android:layout_marginEnd="@dimen/grid_spacing"
        android:background="@drawable/cell_white_bg"
        android:padding="@dimen/cell_padding"
        android:text="Status"
        android:textSize="@dimen/body_three"
        android:textColor="@color/text_secondary"
        android:gravity="center" />

</LinearLayout>