<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed or Hovered State (Slight Gray) -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/sidebar_btn_pressed" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape>
            <solid android:color="@color/sidebar_btn_pressed"/>
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Default State (Accent Blue) -->
    <item>
        <shape>
            <solid android:color="@color/sidebar_btn_primary" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>