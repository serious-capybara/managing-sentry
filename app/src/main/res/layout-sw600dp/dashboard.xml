<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@+id/dash_menu"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:background="@drawable/dash_menu_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/title_sentry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/white"
        android:textSize="@dimen/title"
        app:layout_constraintBottom_toBottomOf="@id/dash_menu"
        app:layout_constraintEnd_toEndOf="@+id/dash_menu"
        app:layout_constraintHorizontal_bias="0.469"
        app:layout_constraintStart_toStartOf="@id/dash_menu"
        app:layout_constraintTop_toTopOf="@+id/dash_menu"
        app:layout_constraintVertical_bias="0.06" />

    <View
        android:id="@+id/divider"
        android:layout_width="250dp"
        android:layout_height="2dp"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/dash_menu"
        app:layout_constraintEnd_toEndOf="@+id/dash_menu"
        app:layout_constraintStart_toStartOf="@id/dash_menu"
        app:layout_constraintTop_toBottomOf="@+id/title_sentry"
        app:layout_constraintVertical_bias="0.026" />

    <Button
        android:id="@+id/dashboard"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:layout_marginTop="50dp"
        android:background="@drawable/button_bg"
        android:gravity="start|center_vertical"
        android:text="Dashboard"
        android:textSize="@dimen/header_two"
        app:layout_constraintBottom_toBottomOf="@+id/dash_menu"
        app:layout_constraintEnd_toEndOf="@id/dash_menu"
        app:layout_constraintStart_toStartOf="@id/dash_menu"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/products"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/button_bg"
        android:gravity="start|center_vertical"
        android:text="Products"
        android:textSize="@dimen/header_two"
        app:layout_constraintBottom_toBottomOf="@+id/dash_menu"
        app:layout_constraintEnd_toEndOf="@id/dash_menu"
        app:layout_constraintStart_toStartOf="@id/dash_menu"
        app:layout_constraintTop_toBottomOf="@+id/dashboard"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/history"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/button_bg"
        android:gravity="start|center_vertical"
        android:text="History"
        android:textSize="@dimen/header_two"
        app:layout_constraintBottom_toBottomOf="@+id/dash_menu"
        app:layout_constraintEnd_toEndOf="@id/dash_menu"
        app:layout_constraintStart_toStartOf="@id/dash_menu"
        app:layout_constraintTop_toBottomOf="@+id/products"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/log_out"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:layout_marginBottom="50dp"
        android:background="@drawable/button_bg"
        android:gravity="center"
        android:text="Log Out"
        android:textSize="@dimen/header_two"
        app:layout_constraintBottom_toBottomOf="@+id/dash_menu"
        app:layout_constraintEnd_toEndOf="@id/dash_menu"
        app:layout_constraintStart_toStartOf="@id/dash_menu"
        app:layout_constraintVertical_bias="0.0" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="978dp"
        android:layout_height="798dp"
        android:layout_marginStart="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/dash_menu"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>