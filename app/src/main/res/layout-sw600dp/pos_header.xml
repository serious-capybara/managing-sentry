<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/row_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/header_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.8"
            android:layout_margin="4dp"
            android:background="@drawable/header_cell_gray_bg"
            android:padding="12dp"
            android:text="Name"
            android:textSize="@dimen/body_two"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/header_category"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/header_cell_gray_bg"
            android:padding="12dp"
            android:text="Category"
            android:textSize="@dimen/body_two"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/header_srp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.7"
            android:layout_margin="4dp"
            android:background="@drawable/header_cell_gray_bg"
            android:padding="12dp"
            android:text="SRP"
            android:textSize="@dimen/body_two"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/header_timestamp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:layout_margin="4dp"
            android:background="@drawable/header_cell_gray_bg"
            android:padding="12dp"
            android:text="TimeStamp"
            android:textSize="@dimen/body_two"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/header_order"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:layout_margin="4dp"
            android:background="@drawable/header_cell_gray_bg"
            android:padding="12dp"
            android:text="Order"
            android:textSize="@dimen/body_two"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/header_quantity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.6"
            android:layout_margin="4dp"
            android:background="@drawable/header_cell_gray_bg"
            android:padding="12dp"
            android:text="Qty"
            android:textSize="@dimen/body_two"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/header_sales"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/header_cell_gray_bg"
            android:padding="12dp"
            android:text="Sales"
            android:textSize="@dimen/body_two"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/header_checkout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:layout_margin="4dp"
            android:background="@drawable/header_cell_gray_bg"
            android:padding="12dp"
            android:text="Checkout"
            android:textSize="@dimen/body_two"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/header_subtotal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/header_cell_gray_bg"
            android:padding="12dp"
            android:text="Subtotal"
            android:textSize="@dimen/body_two"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/header_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/header_cell_gray_bg"
            android:padding="12dp"
            android:text="Status"
            android:textSize="@dimen/body_two"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:gravity="center" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>