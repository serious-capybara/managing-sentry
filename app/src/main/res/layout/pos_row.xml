<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/row_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/row_name"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:layout_marginTop="@dimen/grid_spacing"
            android:layout_marginEnd="@dimen/grid_spacing"
            android:background="@drawable/cell_white_bg"
            android:padding="@dimen/cell_padding"
            android:text="Name"
            android:textSize="@dimen/body_three"
            android:textColor="@android:color/black"
            android:gravity="start|center_vertical" />

        <TextView
            android:id="@+id/row_category"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:layout_marginTop="@dimen/grid_spacing"
            android:layout_marginEnd="@dimen/grid_spacing"
            android:background="@drawable/cell_white_bg"
            android:padding="@dimen/cell_padding"
            android:text="Category"
            android:textSize="@dimen/body_three"
            android:textColor="@android:color/black"
            android:gravity="center" />

        <TextView
            android:id="@+id/row_srp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:layout_marginTop="@dimen/grid_spacing"
            android:layout_marginEnd="@dimen/grid_spacing"
            android:background="@drawable/cell_white_bg"
            android:padding="@dimen/cell_padding"
            android:text="₱ 0.00"
            android:textSize="@dimen/body_three"
            android:textColor="@android:color/black"
            android:gravity="center" />

        <TextView
            android:id="@+id/row_timestamp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:layout_marginTop="@dimen/grid_spacing"
            android:layout_marginEnd="@dimen/grid_spacing"
            android:background="@drawable/cell_white_bg"
            android:padding="@dimen/cell_padding"
            android:text="Time"
            android:textSize="@dimen/body_three"
            android:textColor="@android:color/black"
            android:gravity="center" />

        <TextView
            android:id="@+id/row_order"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:layout_marginTop="@dimen/grid_spacing"
            android:layout_marginEnd="@dimen/grid_spacing"
            android:background="@drawable/cell_white_bg"
            android:padding="@dimen/cell_padding"
            android:text="ORD-0"
            android:textSize="@dimen/body_three"
            android:textColor="@android:color/black"
            android:gravity="center" />

        <TextView
            android:id="@+id/row_quantity"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.5"
            android:layout_marginTop="@dimen/grid_spacing"
            android:layout_marginEnd="@dimen/grid_spacing"
            android:background="@drawable/cell_white_bg"
            android:padding="@dimen/cell_padding"
            android:text="0"
            android:textSize="@dimen/body_three"
            android:textColor="@android:color/black"
            android:gravity="center" />

        <TextView
            android:id="@+id/row_sales"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:layout_marginTop="@dimen/grid_spacing"
            android:layout_marginEnd="@dimen/grid_spacing"
            android:background="@drawable/cell_white_bg"
            android:padding="@dimen/cell_padding"
            android:text="₱ 0.00"
            android:textSize="@dimen/body_three"
            android:textColor="@android:color/black"
            android:gravity="center" />

        <TextView
            android:id="@+id/row_subtotal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:layout_marginTop="@dimen/grid_spacing"
            android:layout_marginEnd="@dimen/grid_spacing"
            android:background="@drawable/cell_white_bg"
            android:padding="@dimen/cell_padding"
            android:text="₱ 0.00"
            android:textSize="@dimen/body_three"
            android:textColor="@android:color/black"
            android:gravity="center" />

        <Button
            android:id="@+id/row_checkout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:layout_marginTop="@dimen/grid_spacing"
            android:layout_marginEnd="@dimen/grid_spacing"
            android:background="@drawable/button_green_bg"
            app:backgroundTint="@null"
            android:padding="2dp"
            android:text="Add"
            android:textAllCaps="false"
            android:textSize="@dimen/body_three"
            android:textColor="@android:color/white"
            android:gravity="center" />

        <TextView
            android:id="@+id/row_status"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:layout_marginTop="@dimen/grid_spacing"
            android:layout_marginEnd="@dimen/grid_spacing"
            android:background="@drawable/cell_white_bg"
            android:padding="@dimen/cell_padding"
            android:text="Status"
            android:textSize="@dimen/body_three"
            android:textColor="@android:color/black"
            android:gravity="center" />

        <LinearLayout
            android:id="@+id/row_cart_actions"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/grid_spacing"
            android:layout_marginEnd="@dimen/grid_spacing"
            android:gravity="center"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btn_minus"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="2dp"
                android:background="@drawable/button_circle_bg"
                android:src="@drawable/ic_minus"
                app:tint="@color/sidebar_btn_critical" />

            <ImageButton
                android:id="@+id/btn_plus"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/button_circle_bg"
                android:src="@drawable/ic_plus"
                app:tint="@color/success_green" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>