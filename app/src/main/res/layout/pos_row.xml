<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/row_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/row_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.8"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/cell_white_bg"
            android:padding="12dp"
            android:text="Sentry Vitamin C"
            android:textSize="@dimen/body_two"
            android:textColor="@android:color/black"
            android:gravity="start|center_vertical" />

        <TextView
            android:id="@+id/row_category"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/cell_white_bg"
            android:padding="12dp"
            android:text="Vitamins"
            android:textSize="@dimen/body_two"
            android:textColor="@android:color/black"
            android:gravity="center" />

        <TextView
            android:id="@+id/row_srp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.7"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/cell_white_bg"
            android:padding="12dp"
            android:text="₱ 150.00"
            android:textSize="@dimen/body_two"
            android:textColor="@android:color/black"
            android:gravity="center" />

        <TextView
            android:id="@+id/row_timestamp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/cell_white_bg"
            android:padding="12dp"
            android:text="2026-08-19 10:00 AM"
            android:textSize="@dimen/body_two"
            android:textColor="@android:color/black"
            android:gravity="center" />

        <TextView
            android:id="@+id/row_order"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/cell_white_bg"
            android:padding="12dp"
            android:text="ORD-00123"
            android:textSize="@dimen/body_two"
            android:textColor="@android:color/black"
            android:gravity="center" />

        <TextView
            android:id="@+id/row_quantity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.6"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/cell_white_bg"
            android:padding="12dp"
            android:text="10"
            android:textSize="@dimen/body_two"
            android:textColor="@android:color/black"
            android:gravity="center" />

        <TextView
            android:id="@+id/row_sales"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/cell_white_bg"
            android:padding="12dp"
            android:text="₱ 1,500.00"
            android:textSize="@dimen/body_two"
            android:textColor="@android:color/black"
            android:gravity="center" />

        <TextView
            android:id="@+id/row_subtotal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/cell_white_bg"
            android:padding="12dp"
            android:text="₱ 0.00"
            android:textSize="@dimen/body_two"
            android:textColor="@android:color/black"
            android:gravity="center" />

        <Button
            android:id="@+id/row_checkout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/button_green_bg"
            app:backgroundTint="@null"
            android:padding="8dp"
            android:text="Add to Cart"
            android:textAllCaps="false"
            android:textSize="@dimen/body_two"
            android:textColor="@android:color/white"
            android:gravity="center" />

        <TextView
            android:id="@+id/row_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/cell_white_bg"
            android:padding="12dp"
            android:text="Completed"
            android:textSize="@dimen/body_two"
            android:textColor="@android:color/black"
            android:gravity="center" />

        <LinearLayout
            android:id="@+id/row_cart_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btn_minus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/button_circle_bg"
                android:src="@drawable/ic_minus"
                app:tint="@color/sidebar_btn_critical" />

            <ImageButton
                android:id="@+id/btn_plus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/button_circle_bg"
                android:src="@drawable/ic_plus"
                app:tint="@color/success_green" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>