<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cart_container_bg"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/total_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/cell_white_bg"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@id/btn_checkout"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total"
            android:textSize="@dimen/body_two"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/tv_total_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="₱ 0.00"
            android:textSize="@dimen/header_two"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:gravity="center" />

    </LinearLayout>

    <Button
        android:id="@+id/btn_checkout"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:background="@drawable/button_green_bg"
        app:backgroundTint="@null"
        android:text="Checkout"
        android:textAllCaps="false"
        android:textSize="@dimen/body_two"
        android:textColor="@android:color/white"
        app:layout_constraintBottom_toTopOf="@id/btn_clean_cart" />

    <Button
        android:id="@+id/btn_clean_cart"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/button_red_bg"
        app:backgroundTint="@null"
        android:text="Clean Cart"
        android:textAllCaps="false"
        android:textSize="@dimen/body_two"
        android:textColor="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>